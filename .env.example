# Copy this file to .env.local:   Copy-Item .env.example .env.local
# Never commit .env.local

# Where the Express backend runs. Used only by the Next.js server (the /api proxy), never by the browser.
BACKEND_URL=http://localhost:4000

# true = every module's API call returns its mock data (useful when the backend isn't running).
NEXT_PUBLIC_USE_MOCKS=false
