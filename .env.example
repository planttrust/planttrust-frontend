# ─── PlanTrust Frontend Environment Configuration ───────────────────────────
# Copy this file to .env.local for local development.
# In production / Docker Compose, NEXT_PUBLIC_API_URL points to the unified backend.
# ─────────────────────────────────────────────────────────────────────────────

# Unified PlanTrust Backend API (Unified Express server on port 3000)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional per-module overrides (if testing isolated services or mock endpoints)
# Defaults to NEXT_PUBLIC_API_URL if unset
NEXT_PUBLIC_MODULE1_URL=http://localhost:3000
NEXT_PUBLIC_MODULE2_URL=http://localhost:3000
NEXT_PUBLIC_MODULE3_URL=http://localhost:3000
NEXT_PUBLIC_MODULE4_URL=http://localhost:3000
NEXT_PUBLIC_MODULE5_URL=http://localhost:3000

# Mock Mode (Set to 'true' to use client-side mock fallbacks when backend is offline)
NEXT_PUBLIC_ENABLE_MOCKS=false
